# VITE_* values are browser-visible and injected into the bundle at build time.
# Never store secrets in these variables.

# Required: Auth0 SPA and API authorization settings.
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.example.invalid

# Required for production builds: public base URL of the application API.
VITE_API_URL=https://api.example.invalid/api/v1

# Optional: required only for Stripe payment features. Use a publishable key (pk_*), never a secret key (sk_*).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
